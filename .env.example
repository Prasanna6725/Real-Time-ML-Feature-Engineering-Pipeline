KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ZOOKEEPER_CONNECT=zookeeper:2181

USER_EVENTS_TOPIC=user-events
CONTENT_METADATA_TOPIC=content-metadata
FEATURE_STORE_TOPIC=feature-store
PIPELINE_METRICS_TOPIC=pipeline-metrics

PRODUCER_HTTP_PORT=8000
PRODUCER_SPEEDUP_FACTOR=60
PRODUCER_EVENT_INTERVAL_SECONDS=0.2
PRODUCER_LATE_EVENT_RATE=0.1
PRODUCER_SIMULATION_SEED=42
PRODUCER_LATE_EVENT_MIN_SECONDS=35
PRODUCER_LATE_EVENT_MAX_SECONDS=90
PRODUCER_DATA_DIR=/data

DASHBOARD_PORT=8501
DASHBOARD_HTTP_HOST=0.0.0.0

PIPELINE_HTTP_PORT=8090
PIPELINE_PARALLELISM=1

TASKMANAGER_PORT=8082
